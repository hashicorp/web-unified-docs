/**
 * Redirects in this file are intended to be for documentation content only.
 * The redirects will be applied to developer.hashicorp.com.
 *
 * NOTE: a redirect whose `source` contains a wildcard always wins over one
 * that does not, whatever the order in this file. The catch-all below has
 * one, so every page-specific rule above it needs `/:slug*` on the end to
 * take precedence.
 */
[
  // --- specific rules first, each with its own wildcard ---
  {
    "source": "/hcp/docs/vault/audit-log/:slug*",
    "destination": "/vault/cloud/what-is-hcp-vault/integrations",
    "permanent": true,
  },
  {
    "source": "/hcp/docs/vault/constraints-and-known-issues/:slug*",
    "destination":
      "/vault/cloud/get-started/deployment-considerations/constraints-and-limitations",
    "permanent": true,
  },
  {
    "source": "/hcp/docs/vault/constraints-and-limitations/:slug*",
    "destination":
      "/vault/cloud/get-started/deployment-considerations/constraints-and-limitations",
    "permanent": true,
  },
  {
    "source": "/hcp/docs/vault/tiers-and-features/:slug*",
    "destination":
      "/vault/cloud/get-started/deployment-considerations/tiers-and-features",
    "permanent": true,
  },
  {
    "source": "/hcp/docs/vault/migrate-to-hcp/:slug*",
    "destination":
      "/vault/cloud/get-started/deployment-considerations/migrate-to-hcp",
    "permanent": true,
  },
  {
    "source": "/hcp/docs/vault/integrations/:slug*",
    "destination": "/vault/cloud/what-is-hcp-vault/integrations",
    "permanent": true,
  },
  {
    "source": "/hcp/docs/vault/security-overview/:slug*",
    "destination": "/vault/cloud/what-is-hcp-vault/security-overview",
    "permanent": true,
  },
  {
    "source": "/hcp/docs/vault/high-avail-disaster-recover/:slug*",
    "destination":
      "/vault/cloud/what-is-hcp-vault/high-avail-disaster-recover",
    "permanent": true,
  },
  {
    "source": "/hcp/docs/vault/vault-permissions/:slug*",
    "destination": "/vault/cloud/get-started/vault-permissions",
    "permanent": true,
  },
  {
    "source": "/hcp/docs/vault/secrets-inventory/:slug*",
    "destination": "/vault/cloud/reporting/secrets-inventory-reporting",
    "permanent": true,
  },
  {
    "source": "/hcp/docs/vault/azure-public-beta/:slug*",
    "destination": "/vault/cloud",
    "permanent": true,
  },
  // --- moved into the versioned Vault docs ---
  // `client/faq` must stay above `client`, or `client/:slug*` swallows it.
  // These four previously lived in content/hcp-docs/redirects.jsonc; the
  // catch-all below is evaluated before that file, so they no longer fire
  // there and have been moved here.
  {
    "source": "/hcp/docs/vault/what-is-hcp-vault/client/faq/:slug*",
    "destination": "/vault/docs/concepts/billing/clients/faq",
    "permanent": true,
  },
  {
    "source": "/hcp/docs/vault/what-is-hcp-vault/client/:slug*",
    "destination": "/vault/docs/concepts/billing/clients",
    "permanent": true,
  },
  {
    "source": "/hcp/docs/vault/client/faq/:slug*",
    "destination": "/vault/docs/concepts/billing/clients/faq",
    "permanent": true,
  },
  {
    "source": "/hcp/docs/vault/client/:slug*",
    "destination": "/vault/docs/concepts/billing/clients",
    "permanent": true,
  },
  {
    "source": "/hcp/docs/vault/login-mfa/:slug*",
    "destination": "/vault/docs/auth/login-mfa",
    "permanent": true,
  },
  {
    "source": "/hcp/docs/vault/administrations/:slug*",
    "destination": "/vault/docs/enterprise/namespaces#privileged-endpoints",
    "permanent": true,
  },
  // --- catch-all for everything else, including the docs root ---
  {
    "source": "/hcp/docs/vault/:slug*",
    "destination": "/vault/cloud/:slug*",
    "permanent": true,
  },
  // The old landing page's content is now the docs root.
  {
    "source": "/vault/cloud/what-is-hcp-vault",
    "destination": "/vault/cloud",
    "permanent": true,
  },
]
