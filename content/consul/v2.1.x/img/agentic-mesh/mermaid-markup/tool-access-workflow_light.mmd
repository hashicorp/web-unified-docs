flowchart TB
  agent["AI agent"]
  subgraph sidecar["MCP Sidecar"]
    policy["Tool policy"]
    approval["Human approval<br/>if required"]
  end
  inmesh["In-mesh MCP server"]
  subgraph tgw["Terminating gateway"]
    cip["Credential Injection Processor<br/>Adds the bound credential"]
  end
  cred["Vault or<br/>Kubernetes Secret"]
  ext["External MCP server"]

  agent --> policy
  policy --> approval
  approval -->|in-mesh path| inmesh
  approval -->|external path| cip
  cip -->|TLS| ext
  cred -.->|credential| cip

  classDef default fill:#ffffff,stroke:#80848d,stroke-width:1.5px,color:#0c0c0e
  style sidecar fill:#fdf2f6,stroke:#ca2171,stroke-width:3px,color:#0c0c0e
  style tgw fill:#fdf2f6,stroke:#ca2171,stroke-width:3px,color:#0c0c0e
  linkStyle 0,1,2,3,4 stroke:#656a73,stroke-width:1.5px
  linkStyle 5 stroke:#656a73,stroke-width:1.5px,stroke-dasharray:8 5
