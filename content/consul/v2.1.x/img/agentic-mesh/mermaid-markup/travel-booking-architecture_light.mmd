%%{init: {"flowchart":{"nodeSpacing":25,"padding":10}}}%%
flowchart TB
  idp["IBM Verify<br/>Identity provider"]
  app["Traveler and<br/>travel application"]
  cp["Consul control plane"]
  apigw["API gateway"]
  orch["Travel orchestrator"]
  igw["AI Inference Gateway"]
  model["Self-hosted model"]
  obs["AI observability<br/>Agentic Analytics"]
  agents["Weather agent and<br/>booking agent"]
  mcp["In-mesh MCP servers"]
  tgw["Terminating gateway<br/>Credential Injection<br/>Processor"]
  vault["Vault"]
  ext["External MCP server"]

  %% Requests: links 0 to 5
  app --> apigw
  apigw --> orch
  orch --> agents
  agents --> mcp
  agents --> tgw
  tgw --> ext
  %% Model access: links 6 to 7
  orch ==> igw
  igw ==> model
  %% Identity, credentials, and policy: links 8 to 11
  idp -.-> app
  idp -.-> orch
  cp -.-> orch
  vault -.-> tgw
  %% Telemetry: link 12
  igw -.-> obs

  classDef default fill:#ffffff,stroke:#80848d,stroke-width:1.5px,color:#0c0c0e
  classDef arfc fill:#ffffff,stroke:#ca2171,stroke-width:3px,color:#0c0c0e
  class igw,tgw,cp,obs arfc
  linkStyle 0,1,2,3,4,5 stroke:#656a73,stroke-width:1.5px
  linkStyle 6,7 stroke:#3b3d45,stroke-width:3px
  linkStyle 8,9,10,11 stroke:#656a73,stroke-width:1.5px,stroke-dasharray:8 5
  linkStyle 12 stroke:#656a73,stroke-width:1.5px,stroke-dasharray:2 4
