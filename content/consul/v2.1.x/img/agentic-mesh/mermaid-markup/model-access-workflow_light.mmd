flowchart TB
  agent["AI agent<br/>Agent + MCP Sidecar"]
  subgraph igw["AI Inference Gateway"]
    pre["1. Processor, before routing<br/>Resolve identity, validate,<br/>redact PII"]
    route["2. Envoy routing<br/>Pick the capability's<br/>highest-priority tier"]
    post["3. Processor, after routing<br/>Translate for the<br/>selected provider"]
    resp["4. Processor, on response<br/>Normalize, redact PII,<br/>record usage"]
  end
  subgraph tier1["Tier 1"]
    modelb["Model B"]
  end
  subgraph tier0["Tier 0"]
    modela["Model A"]
  end

  agent --> pre
  pre --> route
  route --> post
  post -->|first attempt| modela
  post -->|retriable failure:<br/>next tier| modelb
  modelb --> resp
  resp -->|response| agent

  classDef default fill:#ffffff,stroke:#80848d,stroke-width:1.5px,color:#0c0c0e
  style igw fill:#fdf2f6,stroke:#ca2171,stroke-width:3px,color:#0c0c0e
  style tier0 fill:#f4f5f7,stroke:#80848d,stroke-width:1px,color:#0c0c0e
  style tier1 fill:#f4f5f7,stroke:#80848d,stroke-width:1px,color:#0c0c0e
  linkStyle 0,1,2,3,5,6 stroke:#656a73,stroke-width:1.5px
  linkStyle 4 stroke:#656a73,stroke-width:1.5px,stroke-dasharray:8 5
