%%{init: {"flowchart":{"nodeSpacing":40,"rankSpacing":50,"padding":10}}}%%
flowchart TB
  agent["Agent<br/>Sends traceparent"]
  subgraph proxy["AI Inference Gateway or MCP Sidecar"]
    envoy["Envoy"]
    proc["External processor"]
  end
  upstream["Model or tool"]
  entry["Entry span<br/>Parent from traceparent"]
  egress["Egress span<br/>Emitted by Envoy"]
  payload["Payload span<br/>Emitted by the processor"]

  %% Requests: links 0 to 2
  agent --> envoy
  envoy -->|ext_proc| proc
  envoy --> upstream
  %% Span emission: links 3 to 4
  envoy -.-> egress
  proc -.-> payload
  %% Parent-child: links 5 to 6
  egress --- entry
  payload --- entry

  classDef default fill:#ffffff,stroke:#80848d,stroke-width:1.5px,color:#0c0c0e
  classDef span fill:#f4f5f7,stroke:#80848d,stroke-width:1.5px,color:#0c0c0e
  class entry,egress,payload span
  style proxy fill:#fdf2f6,stroke:#ca2171,stroke-width:3px,color:#0c0c0e
  linkStyle 0,1,2 stroke:#656a73,stroke-width:1.5px
  linkStyle 3,4 stroke:#656a73,stroke-width:1.5px,stroke-dasharray:2 4
  linkStyle 5,6 stroke:#656a73,stroke-width:1.5px
