flowchart TB
  agent["AI agent"]
  subgraph sidecar["MCP Sidecar"]
    policy["Tool policy"]
    approval["Human approval<br/>if required"]
  end
  inmesh["In-mesh MCP server"]
  subgraph tgw["Terminating gateway"]
    cip["Credential Injection Processor<br/>Adds the bound credential"]
  end
  cred["Vault or<br/>Kubernetes Secret"]
  ext["External MCP server"]

  agent --> policy
  policy --> approval
  approval -->|in-mesh path| inmesh
  approval -->|external path| cip
  cip -->|TLS| ext
  cred -.->|credential| cip

  classDef default fill:#1d1e23,stroke:#7d808a,stroke-width:1.5px,color:#efeff1
  style sidecar fill:#24131b,stroke:#e8578f,stroke-width:3px,color:#efeff1
  style tgw fill:#24131b,stroke:#e8578f,stroke-width:3px,color:#efeff1
  linkStyle 0,1,2,3,4 stroke:#9b9ea6,stroke-width:1.5px
  linkStyle 5 stroke:#9b9ea6,stroke-width:1.5px,stroke-dasharray:8 5
