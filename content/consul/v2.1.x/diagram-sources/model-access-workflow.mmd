%%{init: {"flowchart":{"nodeSpacing":25,"padding":10}}}%%
flowchart TB
  agent["AI agent<br/>Agent + MCP Sidecar"]
  subgraph igw["AI Inference Gateway"]
    pre["1. Processor, before routing<br/>Resolve identity, validate,<br/>redact PII"]
    route["2. Envoy routing<br/>Pick the capability's<br/>highest-priority tier"]
    post["3. Processor, after routing<br/>Translate for the<br/>selected provider"]
    resp["4. Processor, on response<br/>Normalize, redact PII,<br/>record usage"]
  end
  subgraph tier1["Tier 1"]
    modelb["Model B"]
  end
  subgraph tier0["Tier 0"]
    modela["Model A"]
  end

  agent --> pre
  pre --> route
  route --> post
  post -->|first attempt| modela
  post -->|retriable failure:<br/>next tier| modelb
  modelb --> resp
  resp -->|response| agent

  classDef default fill:$node,stroke:$node_border,stroke-width:1.5px,color:$text
  style igw fill:$arf,stroke:$accent_border,stroke-width:3px,color:$text
  style tier0 fill:$cluster,stroke:$cluster_border,stroke-width:1px,color:$text
  style tier1 fill:$cluster,stroke:$cluster_border,stroke-width:1px,color:$text
  linkStyle 0,1,2,3,5,6 stroke:$line,stroke-width:1.5px
  linkStyle 4 stroke:$line,stroke-width:1.5px,stroke-dasharray:8 5
