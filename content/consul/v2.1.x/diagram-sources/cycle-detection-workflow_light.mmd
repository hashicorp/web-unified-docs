flowchart LR
  agent["AI agent"]
  proxy["AI Inference Gateway<br/>or MCP Sidecar<br/>with enforcement"]
  upstream["Model or tool"]
  subgraph analysis["Analysis, outside the request path"]
    otel["OpenTelemetry Collector"]
    backend["Trace backend"]
    relay["Span relay"]
    queue["BullMQ queue"]
    analytics["Agentic Analytics"]
    state["Protection state"]
  end

  agent -->|request| proxy
  proxy --> upstream
  proxy -.->|spans| otel
  otel -.-> backend
  otel -.-> relay
  relay -.->|trace IDs| queue
  queue -.-> analytics
  backend -.->|1. fetch trace| analytics
  analytics -->|2. find cycle<br/>3. open the agent's circuit| state
  state -.->|enforcement reads state| proxy
  proxy -->|4. reject later requests<br/>with HTTP 503| agent

  classDef default fill:#ffffff,stroke:#c2c5cb,stroke-width:1.5px,color:#0c0c0e
  classDef arfc fill:#ffffff,stroke:#ca2171,stroke-width:2px,color:#0c0c0e
  class proxy,analytics arfc
  style analysis fill:#f4f5f7,stroke:#c2c5cb,stroke-width:1px,color:#0c0c0e
  linkStyle 0,1,8,10 stroke:#8c9099,stroke-width:1.5px
  linkStyle 2,3,4,5,6,7,9 stroke:#8c9099,stroke-width:1.5px,stroke-dasharray:2 4
