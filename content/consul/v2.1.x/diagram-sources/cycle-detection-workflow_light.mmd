%%{init: {"theme":"base","fontFamily":"Helvetica, Arial, sans-serif","flowchart":{"curve":"step","nodeSpacing":60,"rankSpacing":75,"htmlLabels":true},"themeVariables":{"fontFamily":"Helvetica, Arial, sans-serif","fontSize":"16px","background":"#ffffff","primaryColor":"#ffffff","primaryBorderColor":"#80848d","primaryTextColor":"#0c0c0e","lineColor":"#656a73","clusterBkg":"#f4f5f7","clusterBorder":"#80848d","titleColor":"#0c0c0e","edgeLabelBackground":"#ffffff","actorBkg":"#ffffff","actorBorder":"#ca2171","actorTextColor":"#0c0c0e","actorLineColor":"#80848d","signalColor":"#656a73","signalTextColor":"#0c0c0e","noteBkgColor":"#f4f5f7","noteBorderColor":"#80848d","noteTextColor":"#0c0c0e","activationBkgColor":"#fdf2f6","activationBorderColor":"#c1527f","sequenceNumberColor":"#ffffff"},"sequence":{"mirrorActors":false,"width":130,"actorMargin":20,"messageMargin":45,"boxMargin":10,"noteMargin":12,"wrap":true,"actorFontSize":15,"messageFontSize":15}}}%%
%%{init: {"flowchart":{"nodeSpacing":25,"padding":10}}}%%
flowchart TB
  agent["AI agent"]
  proxy["AI Inference Gateway<br/>or MCP Sidecar<br/>with enforcement"]
  upstream["Model or tool"]
  subgraph analysis["Analysis, outside the request path"]
    otel["OpenTelemetry Collector"]
    backend["Trace backend"]
    relay["Span relay"]
    queue["BullMQ queue"]
    analytics["Agentic Analytics"]
    state["Protection state"]
  end

  agent -->|request| proxy
  proxy --> upstream
  proxy -.->|spans| otel
  otel -.-> backend
  otel -.-> relay
  relay -.->|trace IDs| queue
  queue -.-> analytics
  backend -.->|1. fetch trace| analytics
  analytics -->|2. find cycle<br/>3. open the agent's circuit| state
  state -.->|enforcement reads state| proxy
  proxy -->|4. reject later requests<br/>with HTTP 503| agent

  classDef default fill:#ffffff,stroke:#80848d,stroke-width:1.5px,color:#0c0c0e
  classDef arfc fill:#ffffff,stroke:#ca2171,stroke-width:3px,color:#0c0c0e
  class proxy,analytics arfc
  style analysis fill:#f4f5f7,stroke:#80848d,stroke-width:1px,color:#0c0c0e
  linkStyle 0,1,8,10 stroke:#656a73,stroke-width:1.5px
  linkStyle 2,3,4,5,6,7,9 stroke:#656a73,stroke-width:1.5px,stroke-dasharray:2 4
