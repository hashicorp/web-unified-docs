flowchart LR
  agent["AI agent"]
  subgraph sidecar["MCP Sidecar"]
    policy["Tool policy"]
    approval["Human approval<br/>if required"]
  end
  inmesh["In-mesh MCP server"]
  subgraph tgw["Terminating gateway"]
    cip["Credential Injection Processor<br/>Adds the bound credential"]
  end
  cred["Vault or<br/>Kubernetes Secret"]
  ext["External MCP server"]

  agent --> policy
  policy --> approval
  approval -->|in-mesh path| inmesh
  approval -->|external path| cip
  cip -->|TLS| ext
  cred -.->|credential| cip

  classDef default fill:$node,stroke:$node_border,stroke-width:1.5px,color:$text
  style sidecar fill:$arf,stroke:$arf_border,stroke-width:1.5px,color:$text
  style tgw fill:$arf,stroke:$arf_border,stroke-width:1.5px,color:$text
  linkStyle 0,1,2,3,4 stroke:$line,stroke-width:1.5px
  linkStyle 5 stroke:$line,stroke-width:1.5px,stroke-dasharray:8 5
