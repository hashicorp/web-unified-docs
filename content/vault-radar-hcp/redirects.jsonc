/**
 * Redirects in this file are intended to be for documentation content only.
 * The redirects will be applied to developer.hashicorp.com.
 *
 * NOTE: a redirect whose `source` contains a wildcard always wins over one
 * that does not, whatever the order in this file. The catch-all below has
 * one, so every page-specific rule above it needs `/:slug*` on the end to
 * take precedence.
 */
[
	// --- specific rules first, each with its own wildcard ---
	{
		"source": "/hcp/docs/vault-radar/get-started/add-code-server/:slug",
		"destination": "/vault-radar/cloud/get-started/add-data-sources/:slug",
		"permanent": true,
	},
	{
		"source": "/hcp/docs/vault-radar/concepts/:slug*",
		"destination": "/vault-radar/cloud/manage/:slug*",
		"permanent": true,
	},
	{
		"source": "/hcp/docs/vault-radar/manage/agent/deploy/:slug*",
		"destination": "/vault-radar/cloud/agent/deploy",
		"permanent": true,
	},
	{
		"source": "/hcp/docs/vault-radar/manage/agent/overview/:slug*",
		"destination": "/vault-radar/cloud/agent/overview",
		"permanent": true,
	},
	{
		"source": "/hcp/docs/vault-radar/get-started/write-global-ignore-rules/:slug*",
		"destination": "/vault-radar/cloud/manage/write-global-ignore-rules",
		"permanent": true,
	},
	// --- catch-all for everything else under /hcp/docs/vault-radar ---
	// `:slug+` rather than `:slug*` so it requires at least one path segment
	// and leaves the docs root to the rule below.
	{
		"source": "/hcp/docs/vault-radar/:slug+",
		"destination": "/vault-radar/cloud/:slug+",
		"permanent": true,
	},
	// --- the docs root itself, which the catch-all deliberately skips ---
	{
		"source": "/hcp/docs/vault-radar",
		"destination": "/vault-radar",
		"permanent": true,
	},
	// --- separate prefix: legacy /vault-radar/docs paths ---
	{
		"source": "/vault-radar/docs/:path*",
		"destination": "/vault-radar/cloud/:path*",
		"permanent": true,
	},
]
