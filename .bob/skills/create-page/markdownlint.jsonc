// markdownlint-cli2 config for the create-page skill.
// Encodes the mechanical, auto-fixable rules from HashiCorp's style guide
// (docs/style-guide/markdown/*, docs/style-guide/top-12.md,
// docs/style-guide/general/fonts-and-formats.md). This is a repo-local copy
// (adapted from the global markdown-authoring skill's config) so create-page
// has no dependency on anything outside this repo. Rules the style guide
// calls out that markdownlint can't express are NOT here — those are covered
// by docs/style-guide/ai-checklist.md, consulted directly in Step 5 and
// checked in full by the /docs-review skill in Step 9.
{
  "default": true,

  // Hash-style headings only (no ===/--- underlines).
  "MD003": { "style": "atx" },

  // "-" for unordered list bullets, not "*" or "+".
  "MD004": { "style": "dash" },

  "MD005": true,
  "MD007": { "indent": 2 },

  "MD009": true,
  "MD010": true,
  "MD012": true,

  // Off — HashiCorp's shell-session convention always prefixes commands
  // with "$", even in blocks with no output shown (see
  // docs/style-guide/codeblocks-and-consoles/fonts-and-formats.md). MD014's
  // default behavior strips that prefix in exactly that case, which
  // directly conflicts with the style guide.
  "MD014": false,

  // HashiCorp prose isn't hard-wrapped to a fixed column.
  "MD013": false,

  // Same heading text is fine if it's under different parent sections
  // (e.g. repeated "Example" subheadings).
  "MD024": { "siblings_only": true },

  // Exactly one H1 per document.
  "MD025": true,

  // Off — a doc may open with a badge/image line before its H1, or with
  // frontmatter the linter doesn't parse consistently across configs.
  "MD041": false,

  "MD022": true,
  "MD026": true,

  // Every ordered-list item uses "1." (not incrementing numbers).
  "MD029": { "style": "one" },

  "MD030": true,
  "MD031": true,
  "MD032": true,

  // Off — HashiCorp docs use custom components (<Tip>, <Tabs>, <Warning>,
  // <EnterpriseAlert inline/>, etc.) as inline HTML; don't flag legitimate
  // component usage.
  "MD033": false,

  "MD034": true,
  "MD036": true,

  // Fenced code blocks must declare a language.
  "MD040": true,

  "MD046": { "style": "fenced" },
  "MD047": true,

  // "**bold**" / "_italic_", not "__bold__" / "*italic*".
  "MD049": { "style": "underscore" },
  "MD050": { "style": "asterisk" }
}
