// Markdownlint configuration in jsonc (JSON with comments) format
// .markdownlintrc at the repo root is used as common configuration and the default file for markdownlint-cli
// .markdownlint.jsonc is a symlinked from this file as it is the default file for vscode
// 
{
  // MD004/ul-style
  "MD004": {
    "style": "dash" // follow our style guide
  },
  // MD013/line-length
  "MD013": false, // disable line length check
  "MD024": {
    "siblings_only": true // only report duplicates for sibling headings; allow duplicates at different hierarchy levels (non-siblings)
  },
  "MD025": {
    "front_matter_title": "" // allow frontmatter "title" and h1 in body
  },
  // MD033/allow-html
  "MD033": {
    "allowed_elements": [
      "a",
      "br",
      "CodeBlockConfig",
      "Highlight",
      "Note",
      "pre",
      "Tab",
      "Tabs",
      "Tip",
      "Warning"
      ] // allow some HTML elements in mdx files
  }
}
